{
  "name": "rayde-workspaces",
  "main": "build/index.js",
  "compatibility_date": "2026-07-30",
  "durable_objects": {
    "bindings": [
      {
        "name": "ACCOUNTS",
        "class_name": "AccountSession"
      },
      {
        "name": "WORKSPACES",
        "class_name": "WorkspaceSession"
      },
      {
        "name": "SYNC_WORKSPACES",
        "class_name": "SyncWorkspaceSession"
      },
      {
        "name": "SYNC_ACCOUNTS",
        "class_name": "SyncAccountLedger"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "AccountSession",
        "WorkspaceSession"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "SyncWorkspaceSession",
        "SyncAccountLedger"
      ]
    }
  ],
  "r2_buckets": [
    { "binding": "WORKSPACE_FILES", "bucket_name": "rayde-workspace-files" }
  ],
  "vars": {
    "ASSETS_ORIGIN": "http://127.0.0.1:8731",
    "APP_ORIGIN": "http://127.0.0.1:8787"
  },
  "build": {
    "command": "worker-build --release"
  }
}
