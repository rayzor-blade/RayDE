{
  "name": "rayde-workspaces-staging",
  "main": "build/index.js",
  "compatibility_date": "2026-07-30",
  "durable_objects": {
    "bindings": [
      {
        "name": "ACCOUNTS",
        "class_name": "AccountSession"
      },
      {
        "name": "WORKSPACES",
        "class_name": "WorkspaceSession"
      },
      {
        "name": "SYNC_WORKSPACES",
        "class_name": "SyncWorkspaceSession"
      },
      {
        "name": "SYNC_ACCOUNTS",
        "class_name": "SyncAccountLedger"
      }
    ]
  },

  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    }
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "AccountSession",
        "WorkspaceSession"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "SyncWorkspaceSession",
        "SyncAccountLedger"
      ]
    }
  ],
  "r2_buckets": [
    {
      "binding": "WORKSPACE_FILES",
      "bucket_name": "rayde-workspace-files-staging"
    },
    {
      "binding": "EDITOR_ASSETS",
      "bucket_name": "rayde-editor-assets-staging"
    }
  ],
  "vars": {
    "ASSETS_ORIGIN": "https://assets-staging.rayde.org",
    "APP_ORIGIN": "https://app-staging.rayde.org",
    "GITHUB_APP_SLUG": "rayde-staging",
    "PREVIEW_ORIGIN": "https://preview-staging.rayde.org"
  },
  "build": {
    "command": "npm run build"
  },
  "account_id": "5692cbcf61baf8b51b9b5981611e5d4b",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "app-staging.rayde.org",
      "custom_domain": true
    },
    {
      "pattern": "assets-staging.rayde.org",
      "custom_domain": true
    },
    {
      "pattern": "preview-staging.rayde.org",
      "custom_domain": true
    }
  ]
}
