package rayde.project;

/** Browser and Node entry points share dependencies, with separate compiler targets. */
class WebStarter {
	public static function files(name:String):Map<String, String> return [
		".gitignore" => ".rayde/\n.haxelib/\nbin/\n",
		"build.hxml" => "-cp src\n-main Main\n-lib coconut.vdom\n-lib coconut.data\n-js bin/app.js\n",
		"server.hxml" => "-cp server\n-main Server\n-lib hxnodejs\n-lib tink_web\n-js bin/server.js\n",
		"haxelib.json" => haxe.Json.stringify({name:name.toLowerCase(), version:"0.1.0", classPath:"src", license:"MIT", contributors:[], description:"Coconut browser UI and a Tink Web API", dependencies:{"coconut.vdom":"0.10.1", "coconut.data":"0.12.1", "tink_state":"1.0.0-beta.3", "tink_web":"0.3.0", "hxnodejs":"12.2.0"}}, null, "\t") + "\n",
		"src/Main.hx" => 'import coconut.ui.Renderer;\nimport js.Browser;\n\nclass Main {\n\tstatic function main() {\n\t\tvar counter = new Counter();\n\t\tRenderer.mount(Browser.document.getElementById("app"), \'<App counter={counter}/>\');\n\t}\n}\n',
		"src/Counter.hx" => 'class Counter implements coconut.data.Model {\n\t@:editable var count:Int = 0;\n}\n',
		"src/App.hx" => 'class App extends coconut.ui.View {\n\t@:attribute var counter:Counter;\n\n\tfunction render() \'\n\t\t<main>\n\t\t\t<h1>Hello from Coconut!</h1>\n\t\t\t<p>A reactive Haxe app powered by Tink.</p>\n\t\t\t<button type="button" onclick={counter.count++}>Clicked {counter.count} times</button>\n\t\t</main>\n\t\';\n}\n',
		"server/Server.hx" => 'import tink.http.containers.NodeContainer;\nimport tink.http.Response.OutgoingResponse;\nimport tink.web.routing.Context;\nimport tink.web.routing.Router;\n\nclass Server {\n\tstatic function main() {\n\t\tvar configured = js.Node.process.env.get("PORT");\n\t\tvar port = configured == null ? 8080 : Std.parseInt(configured);\n\t\tif (port == null || port < 1 || port > 65535) throw "PORT must be between 1 and 65535";\n\t\tvar router = new Router<Api>(new Api());\n\t\tnew NodeContainer(new tink.url.Host("127.0.0.1", port)).run(request ->\n\t\t\trouter.route(Context.ofRequest(request)).recover(OutgoingResponse.reportError)\n\t\t).handle(status -> trace(status));\n\t}\n}\n\nclass Api {\n\tpublic function new() {}\n\n\t@:get("/")\n\t@:get("/hello/$$name")\n\tpublic function hello(name = "World"):String return \'Hello, $$name!\';\n}\n',
		"index.html" => '<!doctype html>\n<html lang="en">\n<head>\n\t<meta charset="utf-8">\n\t<meta name="viewport" content="width=device-width, initial-scale=1">\n\t<title>$name</title>\n\t<link rel="stylesheet" href="style.css">\n</head>\n<body>\n\t<div id="app"></div>\n\t<script src="bin/app.js"></script>\n</body>\n</html>\n',
		"style.css" => ":root { font-family: system-ui, sans-serif; color-scheme: light dark; }\nbody { margin: 0; min-height: 100vh; display: grid; place-items: center; }\nmain { max-width: 40rem; padding: 2rem; }\nbutton { font: inherit; padding: .6rem 1rem; cursor: pointer; }\n",
		"README.md" => '# $name\n\nA reactive browser app using [Coconut](https://github.com/MVCoconut/coconut.ui), its Haxe VDOM renderer and Tink observable state. A separate [Tink Web](https://haxetink.github.io/tink_web/) Node.js API example is included.\n\n## Install dependencies\n\nInstall Haxe and Haxelib, then run from this folder:\n\n```sh\nhaxelib newrepo\nhaxelib install haxelib.json\nhaxelib set tink_state 1.0.0-beta.3\n```\n\nDependencies stay in this project\'s local Haxelib repository. Coconut requires the pinned `tink_state` beta; the final command selects it instead of Haxelib\'s older stable default. No dependency installation happens during project creation.\n\n## Browser UI\n\n```sh\nhaxe build.hxml\n```\n\nOpen `index.html` in a browser. Click the button to update the observable `Counter` model and the Coconut view. Edit `src/App.hx` for the UI and `style.css` for styles. Rebuild after changing Haxe files. The browser app runs independently of the optional API.\n\n## Optional HTTP API\n\nInstall Node.js, then run:\n\n```sh\nhaxe server.hxml\nnode bin/server.js\n```\n\nOpen `http://127.0.0.1:8080/` or `http://127.0.0.1:8080/hello/Tink` to exercise the typed routes in `server/Server.hx`. Set the `PORT` environment variable to use another port. The API listens on localhost and does not serve the browser files.\n'
	];
}
