{
  "name": "pocket-studio",
  "version": "0.1.0",
  "license": "Apache",
  "description": "A small project board built with Haxe and Ashui, with a companion RayScript extension.",
  "classPath": "src",
  "rayde": {
    "run": {
      "framework": "ashui",
      "previews": {
        "hl": {
          "mode": "browser",
          "runner": "ash",
          "framework": "ashui",
          "compilerFlags": [
            "-dce",
            "full"
          ]
        }
      }
    }
  },
  "dependencies": {
    "ashui": "0.2.4",
    "ashui-components": "0.2.4",
    "ashui-icons": "0.2.4"
  }
}
