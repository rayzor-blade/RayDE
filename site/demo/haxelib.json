{
  "name": "pocket-studio",
  "version": "0.1.0",
  "license": "MIT",
  "description": "A small project board built with Haxe and Ashui, with a companion RayScript extension.",
  "classPath": "src",
  "rayde": {
    "run": {
      "framework": "ashui",
      "previews": {
        "hl": {
          "mode": "browser",
          "runner": "ash"
        }
      }
    }
  },
  "dependencies": {
    "ashui": "0.2.2",
    "ashui-components": "0.2.2",
    "ashui-icons": "0.2.2"
  }
}
