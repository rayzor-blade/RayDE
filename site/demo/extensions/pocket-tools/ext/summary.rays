// Pure data transformation: shared by the command and the panel.
function summarize(tasks) {
  var result = {total: tasks.length, todo: 0, inProgress: 0, done: 0};
  for (task in tasks) {
    if (task.lane == 'To do') result.todo++;
    if (task.lane == 'In progress') result.inProgress++;
    if (task.lane == 'Done') result.done++;
  }
  return result;
}
