function PocketPanel(props) {
  return <div class="pocket-panel flex flex-col gap-4 p-4">
    <h2 class="text-xl font-semibold">Pocket Studio</h2>
    <p class="text-sm pocket-muted">A small extension, right beside your project.</p>
    <div class="flex items-center justify-between"><span>On the board</span><span>{props.summary.value.total}</span></div>
    <div class="flex items-center justify-between"><span>To do</span><span>{props.summary.value.todo}</span></div>
    <div class="flex items-center justify-between"><span>In progress</span><span>{props.summary.value.inProgress}</span></div>
    <div class="flex items-center justify-between"><span>Done</span><span class="pocket-success">{props.summary.value.done}</span></div>
    <button class="pocket-refresh px-3 py-2 rounded-md" onClick={props.refresh}>Refresh summary</button>
    <p class="text-xs pocket-muted">{props.message}</p>
  </div>;
}
