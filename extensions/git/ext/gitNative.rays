native "git2" {
  @:free(git_repository_free) handle Repository;
  @:free(git_diff_free) handle Diff;
  @:refcounted @:free(git_object_free) handle Tree;
  @:free(git_status_list_free) handle StatusList;
  @:free(git_revwalk_free) handle Walk;
  @:refcounted @:free(git_commit_free) handle Commit;
  @:free(git_reference_iterator_free) handle References;
  @:free(git_reference_free) handle Reference;
  @:free(git_remote_free) handle Remote;
  @:free(git_index_free) handle Index;
  @:free(git_signature_free) handle Signature;
  @:free(git_annotated_commit_free) handle Annotated;
  @:free(git_rebase_free) handle Rebase;
  @:failure(-1) callback PushStatus(name:CString, status:CString, data:Ptr):Int32;
  struct Author { name:CString; email:CString; }
  struct Error { message:CString; klass:Int32; }
  struct StrArray { strings:Ptr; count:SizeT; }
  struct StringPointer { value:CString; }
  struct Buffer { text:CString; reserved:SizeT; size:SizeT; }
  struct RemoteCallbacks {
    version:UInt32; sideband:Ptr; completion:Ptr; credentials:Ptr; certificate:Ptr; transfer:Ptr;
    updateTips:Ptr; pack:Ptr; pushTransfer:Ptr; pushUpdate:PushStatus; negotiation:Ptr;
    transport:Ptr; ready:Ptr; payload:Ptr; resolve:Ptr; updateRefs:Ptr;
  }
  struct ProxyOptions { version:UInt32; kind:Int32; url:CString; credentials:Ptr; certificate:Ptr; payload:Ptr; }
  struct PushOptions { version:UInt32; parallelism:UInt32; callbacks:RemoteCallbacks; proxy:ProxyOptions;
    redirects:Int32; headers:StrArray; pushOptions:StrArray; }
  struct MergeOptions { version:UInt32; flags:UInt32; renameThreshold:UInt32; targetLimit:UInt32; metric:Ptr;
    recursionLimit:UInt32; driver:CString; fileFavor:Int32; fileFlags:UInt32; }
  struct CheckoutOptions { version:UInt32; strategy:UInt32; disableFilters:Int32; dirMode:UInt32; fileMode:UInt32;
    openFlags:Int32; notifyFlags:UInt32; notify:Ptr; notifyData:Ptr; progress:Ptr; progressData:Ptr; paths:StrArray;
    baseline:Ptr; baselineIndex:Ptr; directory:CString; ancestor:CString; ours:CString; theirs:CString; performance:Ptr; performanceData:Ptr; }
  struct RebaseOptions { version:UInt32; quiet:Int32; inMemory:Int32; notes:CString; merge:MergeOptions;
    checkout:CheckoutOptions; create:Ptr; signing:Ptr; data:Ptr; }
  struct CommitPointer { value:Commit; }
  // The pinned build uses SHA-1 object IDs, without the experimental SHA-256 ABI.
  struct Oid {
    b0:UInt8; b1:UInt8; b2:UInt8; b3:UInt8; b4:UInt8; b5:UInt8; b6:UInt8; b7:UInt8; b8:UInt8; b9:UInt8;
    b10:UInt8; b11:UInt8; b12:UInt8; b13:UInt8; b14:UInt8; b15:UInt8; b16:UInt8; b17:UInt8; b18:UInt8; b19:UInt8;
  }
  struct DiffFile { id:Oid; path:CString; size:UInt64; flags:UInt32; mode:UInt16; idAbbrev:UInt16; }
  struct Delta { status:Int32; flags:UInt32; similarity:UInt16; files:UInt16; oldFile:DiffFile; newFile:DiffFile; }
  struct BinaryFile { kind:Int32; data:Ptr; length:SizeT; inflatedLength:SizeT; }
  struct Binary { containsData:UInt32; oldFile:BinaryFile; newFile:BinaryFile; }
  // Only this borrowed prefix is read; hunk storage is never allocated by script.
  struct Hunk { oldStart:Int32; oldLines:Int32; newStart:Int32; newLines:Int32; headerLength:SizeT; }
  struct Line { origin:UInt8; oldLine:Int32; newLine:Int32; lines:Int32; length:SizeT; offset:Int64; content:Ptr; }
  struct StatusEntry { flags:UInt32; headToIndex:Ptr<Delta>; indexToWorkdir:Ptr<Delta>; }
  struct StatusOptions { version:UInt32; show:Int32; flags:UInt32; pathspec:StrArray; baseline:Ptr; renameThreshold:UInt16; }
  struct DiffOptions {
    version:UInt32; flags:UInt32; ignoreSubmodules:Int32; pathspec:StrArray;
    notify:Ptr; progress:Ptr; payload:Ptr; contextLines:UInt32; interhunkLines:UInt32;
    oidType:Int32; idAbbrev:UInt16; maxSize:Int64; oldPrefix:CString; newPrefix:CString;
  }
  @:failure(-1) callback StatusCallback(path:CString, flags:UInt32, data:Ptr):Int32;
  @:failure(-1) callback FileCallback(delta:Delta, progress:Float, data:Ptr):Int32;
  @:failure(-1) callback BinaryCallback(delta:Delta, binary:Binary, data:Ptr):Int32;
  @:failure(-1) callback HunkCallback(delta:Delta, hunk:Hunk, data:Ptr):Int32;
  @:failure(-1) callback LineCallback(delta:Delta, hunk:Hunk, line:Line, data:Ptr):Int32;
  function git_libgit2_init():Int32;
  function git_libgit2_shutdown():Int32;
  function git_libgit2_version(major:Out<Int32>, minor:Out<Int32>, patch:Out<Int32>):Int32;
  function git_libgit2_features():Int32;
  @:blocking function git_error_last():Error;
  @:blocking function git_repository_open_ext(out:Out<Repository>, path:CString, flags:UInt32, ceiling:CString):Int32;
  function git_repository_free(repository:Repository):Void;
  function git_repository_path(repository:Repository):CString;
  function git_repository_workdir(repository:Repository):CString;
  function git_repository_head_unborn(repository:Repository):Int32;
  function git_repository_head_detached(repository:Repository):Int32;
  @:owner(repository) @:blocking function git_repository_head(out:Out<Reference>, repository:Repository):Int32;
  @:blocking function git_status_foreach(repository:Repository, callback:StatusCallback, data:Ptr):Int32;
  function git_status_options_init(options:StatusOptions, version:UInt32):Int32;
  @:owner(repository) @:blocking function git_status_list_new(out:Out<StatusList>, repository:Repository, options:StatusOptions):Int32;
  function git_status_list_entrycount(status:StatusList):SizeT;
  @:owner(status) function git_status_byindex(status:StatusList, index:SizeT):StatusEntry;
  function git_status_list_free(status:StatusList):Void;
  @:owner(repository) @:blocking function git_revparse_single(out:Out<Tree>, repository:Repository, spec:CString):Int32;
  function git_object_free(tree:Tree):Void;
  function git_diff_options_init(options:DiffOptions, version:UInt32):Int32;
  @:owner(repository) @:blocking function git_diff_index_to_workdir(out:Out<Diff>, repository:Repository, index:Ptr, options:DiffOptions):Int32;
  @:owner(repository) @:blocking function git_diff_tree_to_index(out:Out<Diff>, repository:Repository, tree:Tree, index:Ptr, options:DiffOptions):Int32;
  @:owner(repository) @:blocking function git_diff_tree_to_tree(out:Out<Diff>, repository:Repository, oldTree:Tree, newTree:Tree, options:DiffOptions):Int32;
  @:blocking function git_diff_find_similar(diff:Diff, options:Ptr):Int32;
  @:blocking function git_diff_foreach(diff:Diff, file:FileCallback, binary:BinaryCallback, hunk:HunkCallback, line:LineCallback, data:Ptr):Int32;
  function git_diff_free(diff:Diff):Void;
  @:owner(repository) @:blocking function git_revwalk_new(out:Out<Walk>, repository:Repository):Int32;
  function git_revwalk_free(walk:Walk):Void;
  function git_revwalk_sorting(walk:Walk, mode:UInt32):Int32;
  function git_revwalk_simplify_first_parent(walk:Walk):Int32;
  @:blocking function git_revwalk_push_glob(walk:Walk, glob:CString):Int32;
  @:blocking function git_revwalk_push_head(walk:Walk):Int32;
  @:blocking function git_revwalk_push_ref(walk:Walk, ref:CString):Int32;
  @:blocking function git_revwalk_next(out:Oid, walk:Walk):Int32;
  @:owner(repository) @:blocking function git_commit_lookup(out:Out<Commit>, repository:Repository, id:Oid):Int32;
  function git_commit_free(commit:Commit):Void;
  function git_commit_summary(commit:Commit):CString;
  function git_commit_time(commit:Commit):Int64;
  @:owner(commit) function git_commit_author(commit:Commit):Author;
  function git_commit_parentcount(commit:Commit):UInt32;
  @:owner(commit) function git_commit_parent_id(commit:Commit, index:UInt32):Oid;
  function git_oid_tostr_s(id:Oid):CString;
  @:owner(repository) @:blocking function git_reference_iterator_new(out:Out<References>, repository:Repository):Int32;
  function git_reference_iterator_free(references:References):Void;
  @:owner(references) function git_reference_next(out:Out<Reference>, references:References):Int32;
  function git_reference_free(reference:Reference):Void;
  function git_reference_name(reference:Reference):CString;
  function git_reference_shorthand(reference:Reference):CString;
  @:owner(reference) function git_reference_peel(out:Out<Tree>, reference:Reference, kind:Int32):Int32;
  @:owner(tree) function git_object_id(tree:Tree):Oid;
  @:blocking function git_revwalk_push(walk:Walk, id:Oid):Int32;
  @:owner(reference) function git_reference_target(reference:Reference):Oid;
  @:owner(reference) @:blocking function git_reference_set_target(out:Out<Reference>, reference:Reference, id:Oid, message:CString):Int32;
  @:owner(branch) @:blocking function git_branch_upstream(out:Out<Reference>, branch:Reference):Int32;
  @:blocking function git_branch_upstream_remote(out:Buffer, repository:Repository, branch:CString):Int32;
  @:blocking function git_branch_upstream_merge(out:Buffer, repository:Repository, branch:CString):Int32;
  @:blocking function git_branch_set_upstream(branch:Reference, upstream:CString):Int32;
  function git_buf_dispose(buffer:Buffer):Void;
  @:blocking function git_remote_list(out:StrArray, repository:Repository):Int32;
  function git_strarray_dispose(array:StrArray):Void;
  @:owner(repository) @:blocking function git_remote_lookup(out:Out<Remote>, repository:Repository, name:CString):Int32;
  function git_remote_free(remote:Remote):Void;
  @:blocking function git_remote_fetch(remote:Remote, specs:Ptr, options:Ptr, message:CString):Int32;
  function git_push_options_init(options:PushOptions, version:UInt32):Int32;
  @:blocking function git_remote_push(remote:Remote, specs:StrArray, options:PushOptions):Int32;
  @:blocking function git_checkout_tree(repository:Repository, tree:Tree, options:Ptr):Int32;
  @:blocking function git_graph_descendant_of(repository:Repository, commit:Oid, ancestor:Oid):Int32;
  @:blocking function git_signature_default(out:Out<Signature>, repository:Repository):Int32;
  function git_signature_free(signature:Signature):Void;
  @:owner(repository) @:blocking function git_merge_commits(out:Out<Index>, repository:Repository, ours:Commit, theirs:Commit, options:Ptr):Int32;
  function git_index_free(index:Index):Void;
  function git_index_has_conflicts(index:Index):Int32;
  @:blocking function git_index_write_tree_to(out:Oid, index:Index, repository:Repository):Int32;
  @:owner(repository) @:blocking function git_tree_lookup(out:Out<Tree>, repository:Repository, id:Oid):Int32;
  @:blocking function git_commit_create(out:Oid, repository:Repository, update:CString, author:Signature, committer:Signature,
    encoding:CString, message:CString, tree:Tree, count:SizeT, parents:Ptr):Int32;
  @:owner(repository) @:blocking function git_annotated_commit_from_ref(out:Out<Annotated>, repository:Repository, reference:Reference):Int32;
  function git_annotated_commit_free(commit:Annotated):Void;
  function git_rebase_options_init(options:RebaseOptions, version:UInt32):Int32;
  @:owner(repository) @:blocking function git_rebase_init(out:Out<Rebase>, repository:Repository, branch:Annotated, upstream:Annotated, onto:Annotated, options:RebaseOptions):Int32;
  function git_rebase_free(rebase:Rebase):Void;
  @:blocking function git_rebase_next(out:Out<Ptr>, rebase:Rebase):Int32;
  @:owner(rebase) @:blocking function git_rebase_inmemory_index(out:Out<Index>, rebase:Rebase):Int32;
  @:blocking function git_rebase_commit(out:Oid, rebase:Rebase, author:Signature, committer:Signature, encoding:CString, message:CString):Int32;
  @:blocking function git_rebase_finish(rebase:Rebase, signature:Signature):Int32;
  function git_repository_state(repository:Repository):Int32;
}

function check(code, operation) {
  if (code < 0) {
    var error = git_error_last();
    throw operation + ': ' + (error == null ? 'libgit2 error ' + code : error.message);
  }
  return code;
}

function version() {
  var major = Out(Int32), minor = Out(Int32), patch = Out(Int32);
  check(git_libgit2_version(major, minor, patch), 'version');
  return {major: major.value, minor: minor.value, patch: patch.value, features: git_libgit2_features()};
}

function withRepository(path, action) {
  check(git_libgit2_init(), 'initialize');
  var repository = null;
  try {
    var out = Out(Repository);
    check(git_repository_open_ext(out, path, 0, null), 'open repository');
    repository = out.value;
    var result = action(repository);
    repository.close();
    git_libgit2_shutdown();
    return result;
  } catch (error) {
    if (repository != null) repository.close();
    git_libgit2_shutdown();
    throw error;
  }
}

function eachStatus(repository, visit) {
  check(git_status_foreach(repository, StatusCallback((path, flags, data) -> {
    visit(path, flags);
    return 0;
  }), null), 'status callbacks');
}

function statusFlags(repository) {
  var entries = [];
  eachStatus(repository, (path, flags) -> {
    if ((flags & 16384) == 0) entries.push({path: path, flags: flags});
  });
  return entries;
}

function status(repository) {
  var options = alloc(StatusOptions);
  check(git_status_options_init(options, 1), 'status options');
  // Include nested untracked files and detect renames on both sides of the index.
  options.flags = 1 | 16 | 128 | 256;
  var out = Out(StatusList);
  check(git_status_list_new(out, repository, options), 'status');
  var list = out.value;
  try {
    var entries = [];
    for (index in 0...git_status_list_entrycount(list)) {
      var entry = git_status_byindex(list, index);
      var staged = entry.headToIndex, workdir = entry.indexToWorkdir;
      var delta = workdir == null ? staged : workdir;
      var flags = entry.flags;
      entries.push({path: delta.newFile.path == null ? delta.oldFile.path : delta.newFile.path,
        flags: flags, index: flags & 31, workdir: flags & 8064, conflicted: (flags & 32768) != 0,
        renamedFrom: (flags & 8) != 0 && staged != null ? staged.oldFile.path : (flags & 2048) != 0 && workdir != null ? workdir.oldFile.path : null});
    }
    list.close();
    return entries;
  } catch (error) { list.close(); throw error; }
}

function diff(repository, staged) {
  var options = alloc(DiffOptions);
  check(git_diff_options_init(options, 1), 'diff options');
  // Preserve type changes and request binary payload metadata.
  options.flags = 64 | 1073741824;
  var tree = null, out = Out(Diff);
  if (staged) {
    var base = Out(Tree);
    var code = git_revparse_single(base, repository, 'HEAD^{tree}');
    if (code != -3 && code != -9) check(code, 'HEAD tree');
    tree = base.value;
    var code = git_diff_tree_to_index(out, repository, tree, null, options);
    if (tree != null) tree.close();
    check(code, 'staged diff');
  } else check(git_diff_index_to_workdir(out, repository, null, options), 'workdir diff');
  var diff = out.value;
  try {
    check(git_diff_find_similar(diff, null), 'rename detection');
    var files = [], hunks = [], lines = [], binaries = [];
    check(git_diff_foreach(diff,
      FileCallback((delta, progress, data) -> {
        files.push({path: delta.newFile.path, oldPath: delta.oldFile.path, status: delta.status,
          oldSize: delta.oldFile.size, newSize: delta.newFile.size});
        return 0;
      }),
      BinaryCallback((delta, binary, data) -> {
        binaries.push({path: delta.newFile.path, containsData: binary.containsData,
          oldSize: binary.oldFile.inflatedLength, newSize: binary.newFile.inflatedLength});
        return 0;
      }),
      HunkCallback((delta, hunk, data) -> {
        hunks.push({path: delta.newFile.path, oldStart: hunk.oldStart, oldLines: hunk.oldLines,
          newStart: hunk.newStart, newLines: hunk.newLines});
        return 0;
      }),
      LineCallback((delta, hunk, line, data) -> {
        lines.push({path: delta.newFile.path, origin: line.origin, oldLine: line.oldLine, newLine: line.newLine,
          bytes: Bytes(line.content, line.length)});
        return 0;
      }), null), 'diff callbacks');
    diff.close();
    return {files: files, binaries: binaries, hunks: hunks, lines: lines};
  } catch (error) { diff.close(); throw error; }
}

/** Changes against the first parent; a root commit is compared with an empty tree. */
function commitChanges(path, id) {
  return withRepository(path, repository -> changesInRepository(repository, id));
}

function changesInRepository(repository, id) {
    var commit = null, before = null, after = null, changes = null;
    function close() {
      for (handle in [changes, before, after, commit]) if (handle != null) handle.close();
    }
    try {
      var object = Out(Tree);
      check(git_revparse_single(object, repository, id + '^{commit}'), 'resolve commit');
      commit = object.value;
      id = git_oid_tostr_s(git_object_id(commit));
      var out = Out(Commit);
      check(git_commit_lookup(out, repository, git_object_id(commit)), 'lookup commit');
      var info = out.value, parentCount = git_commit_parentcount(info);
      info.close();
      var tree = Out(Tree);
      check(git_revparse_single(tree, repository, id + '^{tree}'), 'commit tree');
      after = tree.value;
      if (parentCount > 0) {
        tree = Out(Tree);
        check(git_revparse_single(tree, repository, id + '^1^{tree}'), 'parent tree');
        before = tree.value;
      }
      var options = alloc(DiffOptions), result = Out(Diff);
      check(git_diff_options_init(options, 1), 'commit diff options');
      options.flags = 64;
      check(git_diff_tree_to_tree(result, repository, before, after, options), 'commit changes');
      changes = result.value;
      check(git_diff_find_similar(changes, null), 'commit rename detection');
      var files = [];
      check(git_diff_foreach(changes, FileCallback((delta, progress, data) -> {
        files.push({path:delta.newFile.path == null ? delta.oldFile.path : delta.newFile.path,
          oldPath:delta.oldFile.path, status:delta.status});
        return 0;
      }), null, null, null, null), 'commit files');
      close();
      return files;
    } catch (failure) { close(); throw failure; }
}

function inspect(path) {
  return withRepository(path, repository -> {
    return {repository: git_repository_path(repository), workdir: git_repository_workdir(repository),
      status: status(repository), staged: diff(repository, true), changes: diff(repository, false)};
  });
}

function historyReference(name) {
  if (name.startsWith('refs/heads/') || name.startsWith('refs/tags/')) return true;
  if (!name.startsWith('refs/remotes/')) return false;
  var parts = name.split('/'), tail = parts[parts.length-1], group = parts[parts.length-2];
  // git-bug keeps remote copies under the remote namespace, outside normal branch history.
  if ((group == 'bugs' || group == 'identities') && tail.length == 64) {
    var hexadecimal = true;
    for (i in 0...tail.length) if ('0123456789abcdef'.indexOf(tail.substr(i,1)) < 0) hexadecimal = false;
    if (hexadecimal) return false;
  }
  return true;
}

function references(repository) {
  var out = Out(References);
  check(git_reference_iterator_new(out, repository), 'references');
  var iterator = out.value, result = [];
  try {
    while (true) {
      var next = Out(Reference), code = git_reference_next(next, iterator);
      if (code == -31) break;
      check(code, 'next reference');
      var ref = next.value;
      try {
        var name = git_reference_name(ref);
        if (!historyReference(name)) { ref.close(); continue; }
        var object = Out(Tree);
        var code = git_reference_peel(object, ref, 1);
        // References to non-commit objects do not participate in commit history.
        if (code == 0) {
          var target = object.value;
          result.push({name: name, label: git_reference_shorthand(ref), target: git_oid_tostr_s(git_object_id(target)),
            kind: name.startsWith('refs/heads/') ? 'branch' : name.startsWith('refs/remotes/') ? 'remote' : 'tag'});
          target.close();
        } else if (code != -3 && code != -12 && code != -19) check(code, 'peel reference');
        ref.close();
      } catch (error) { ref.close(); throw error; }
    }
    iterator.close();
    return result;
  } catch (error) { iterator.close(); throw error; }
}

function repositoryStatus(path) {
  return withRepository(path, repository -> {
    var branch = 'No commits', head = Out(Reference);
    var unborn = check(git_repository_head_unborn(repository), 'repository HEAD state');
    if (unborn == 0) {
      check(git_repository_head(head, repository), 'repository HEAD');
      var ref = head.value;
      try {
        branch = check(git_repository_head_detached(repository), 'detached HEAD state') == 1 ? 'Detached HEAD' : git_reference_shorthand(ref);
        ref.close();
      } catch (error) { ref.close(); throw error; }
    }
    return {repository: git_repository_path(repository), workdir: git_repository_workdir(repository), branch: branch, entries: status(repository)};
  });
}

function openHistory(path, ref = 'all', firstParent = false) {
  check(git_libgit2_init(), 'initialize history');
  var repository = null, walk = null, closed = false, done = false;
  function close() {
    if (closed) return;
    closed = true;
    if (walk != null) walk.close();
    if (repository != null) repository.close();
    git_libgit2_shutdown();
  }
  try {
    var out = Out(Repository);
    check(git_repository_open_ext(out, path, 0, null), 'open history repository');
    repository = out.value;
    var refs = references(repository), cursor = Out(Walk);
    check(git_revwalk_new(cursor, repository), 'history cursor');
    walk = cursor.value;
    check(git_revwalk_sorting(walk, 3), 'history ordering');
    if (firstParent) check(git_revwalk_simplify_first_parent(walk), 'file history ordering');
    if (ref == 'all') {
      for (reference in refs) check(git_revwalk_push_ref(walk, reference.name), 'history reference');
      if (check(git_repository_head_unborn(repository), 'history HEAD state') == 0)
        check(git_revwalk_push_head(walk), 'history HEAD');
    } else if (ref != 'HEAD' || check(git_repository_head_unborn(repository), 'history HEAD state') == 0) {
      var object = Out(Tree);
      check(git_revparse_single(object, repository, ref + '^{commit}'), 'history focus');
      var target = object.value;
      try { check(git_revwalk_push(walk, git_object_id(target)), 'history focus'); target.close(); }
      catch (error) { target.close(); throw error; }
    }
    function next(limit = 100) {
      if (closed) throw 'History cursor is closed';
      if (limit < 1 || limit > 500 || limit != Std.int(limit)) throw 'History page size must be an integer from 1 to 500';
      var rows = [], id = alloc(Oid);
      try {
        while (rows.length < limit && !done) {
          var code = git_revwalk_next(id, walk);
          if (code == -31) { done = true; break; }
          check(code, 'next commit');
          var slot = Out(Commit);
          check(git_commit_lookup(slot, repository, id), 'lookup commit');
          var commit = slot.value;
          try {
            var parents = [], author = git_commit_author(commit);
            for (index in 0...git_commit_parentcount(commit)) parents.push(git_oid_tostr_s(git_commit_parent_id(commit, index)));
            rows.push({id: git_oid_tostr_s(id), subject: git_commit_summary(commit), parents: parents,
              author: author.name, email: author.email, time: git_commit_time(commit)});
            commit.close();
          } catch (error) { commit.close(); throw error; }
        }
        return {commits: rows, done: done};
      } catch (error) { close(); throw error; }
    }
    return {next: next, close: close, changes: id -> changesInRepository(repository, id), refs: refs, repository: git_repository_path(repository), workdir: git_repository_workdir(repository)};
  } catch (error) { close(); throw error; }
}

function branchSetting(repository, name, merge = false) {
  var buffer = alloc(Buffer);
  try {
    var code = merge ? git_branch_upstream_merge(buffer, repository, name) : git_branch_upstream_remote(buffer, repository, name);
    if (code == -3) { git_buf_dispose(buffer); return null; }
    check(code, 'branch upstream');
    var text = buffer.text;
    git_buf_dispose(buffer);
    return text;
  } catch (error) { git_buf_dispose(buffer); throw error; }
}

function defaultRemote(repository) {
  var array = alloc(StrArray);
  try {
    check(git_remote_list(array, repository), 'list remotes');
    var names = [];
    if (array.count > 0) {
      var strings = borrow(StringPointer, array.strings, array.count);
      for (i in 0...array.count) names.push(strings[i].value);
    }
    git_strarray_dispose(array);
    for (name in names) if (name == 'origin') return name;
    if (names.length == 1) return names[0];
    throw names.length == 0 ? 'No remote configured' : 'No upstream configured; select an upstream before using remote actions';
  } catch (error) { git_strarray_dispose(array); throw error; }
}

function integratePull(repository, head, upstream, strategy) {
  var owned = [];
  function keep(handle) { owned.push(handle); return handle; }
  function close() { while (owned.length > 0) owned.pop().close(); }
  try {
    var signer = Out(Signature);
    check(git_signature_default(signer, repository), 'Git committer identity');
    var signature = keep(signer.value), result = '';
    if (strategy == 'merge') {
      var slot = Out(Commit);
      check(git_commit_lookup(slot, repository, git_reference_target(head)), 'local commit'); var ours = keep(slot.value);
      slot = Out(Commit);
      check(git_commit_lookup(slot, repository, git_reference_target(upstream)), 'upstream commit'); var theirs = keep(slot.value);
      var merged = Out(Index);
      check(git_merge_commits(merged, repository, ours, theirs, null), 'merge commits'); var index = keep(merged.value);
      if (git_index_has_conflicts(index) != 0) throw 'Pull merge has conflicts; branch unchanged';
      var treeId = alloc(Oid);
      check(git_index_write_tree_to(treeId, index, repository), 'merged tree');
      var treeOut = Out(Tree);
      check(git_tree_lookup(treeOut, repository, treeId), 'merged tree'); var tree = keep(treeOut.value);
      var parents = alloc(CommitPointer, 2); parents[0].value = ours; parents[1].value = theirs;
      var id = alloc(Oid);
      check(git_commit_create(id, repository, null, signature, signature, null, 'Merge ' + git_reference_shorthand(upstream), tree, 2, parents), 'merge commit');
      result = git_oid_tostr_s(id);
    } else {
      var annotated = Out(Annotated);
      check(git_annotated_commit_from_ref(annotated, repository, head), 'rebase branch'); var branch = keep(annotated.value);
      annotated = Out(Annotated);
      check(git_annotated_commit_from_ref(annotated, repository, upstream), 'rebase upstream'); var base = keep(annotated.value);
      var options = alloc(RebaseOptions);
      check(git_rebase_options_init(options, 1), 'rebase options'); options.inMemory = 1;
      var slot = Out(Rebase);
      check(git_rebase_init(slot, repository, branch, base, null, options), 'prepare rebase'); var rebase = keep(slot.value);
      result = git_oid_tostr_s(git_reference_target(upstream));
      while (true) {
        var operation = Out(Ptr), code = git_rebase_next(operation, rebase);
        if (code == -31) break;
        check(code, 'rebase next');
        var indexOut = Out(Index);
        check(git_rebase_inmemory_index(indexOut, rebase), 'rebase index');
        var index = indexOut.value, conflicted = git_index_has_conflicts(index); index.close();
        if (conflicted != 0) throw 'Pull rebase has conflicts; branch unchanged';
        var id = alloc(Oid), code = git_rebase_commit(id, rebase, null, signature, null, null);
        if (code != -18) { check(code, 'rebase commit'); result = git_oid_tostr_s(id); }
      }
      check(git_rebase_finish(rebase, signature), 'finish rebase');
    }
    close(); return result;
  } catch (error) { close(); throw error; }
}

function remoteOperation(path, operation, strategy = 'ff-only') {
  if (operation != 'fetch' && operation != 'pull' && operation != 'push') throw 'Unknown Git remote operation';
  if (strategy != 'ff-only' && strategy != 'merge' && strategy != 'rebase') throw 'Unknown pull strategy';
  return withRepository(path, repository -> {
    var head = null, remote = null, upstream = null, target = null;
    function close() {
      if (target != null) target.close();
      if (upstream != null) upstream.close();
      if (remote != null) remote.close();
      if (head != null) head.close();
    }
    try {
      var local = null, remoteName = null, destination = null;
      if (check(git_repository_head_unborn(repository), 'HEAD state') == 0 && check(git_repository_head_detached(repository), 'HEAD state') == 0) {
        var slot = Out(Reference);
        check(git_repository_head(slot, repository), 'current branch'); head = slot.value;
        local = git_reference_name(head);
        remoteName = branchSetting(repository, local);
        destination = branchSetting(repository, local, true);
      }
      if (operation != 'fetch' && head == null) throw 'Check out a branch with a commit before ' + operation;
      if (operation == 'pull' && remoteName == null) throw 'No upstream configured for the current branch';
      if (remoteName == null) remoteName = defaultRemote(repository);
      if (remoteName == '.') throw 'The upstream is a local branch, not a remote';
      var slot = Out(Remote);
      check(git_remote_lookup(slot, repository, remoteName), 'open remote ' + remoteName); remote = slot.value;
      if (operation == 'push') {
        if (destination == null) destination = local;
        var string = alloc(StringPointer); string.value = local + ':' + destination;
        var specs = alloc(StrArray); specs.strings = string; specs.count = 1;
        var options = alloc(PushOptions), rejected = '';
        check(git_push_options_init(options, 1), 'push options');
        options.callbacks.pushUpdate = PushStatus((name, status, data) -> {
          if (status != null) rejected = name + ': ' + status;
          return 0;
        });
        check(git_remote_push(remote, specs, options), 'push to ' + remoteName);
        if (rejected != '') throw 'Push rejected: ' + rejected;
        if (branchSetting(repository, local) == null) check(git_branch_set_upstream(head, remoteName + '/' + git_reference_shorthand(head)), 'set upstream');
      } else {
        if (operation == 'pull') {
          if (git_repository_state(repository) != 0) throw 'Finish the current Git operation before pulling';
          if (status(repository).length != 0) throw 'Commit or stash changes before pulling';
        }
        check(git_remote_fetch(remote, null, null, 'RayDE: fetch ' + remoteName), 'fetch from ' + remoteName);
        if (operation == 'pull') {
          var tracked = Out(Reference);
          check(git_branch_upstream(tracked, head), 'upstream branch'); upstream = tracked.value;
          var current = git_reference_target(head), next = git_reference_target(upstream);
          if (git_oid_tostr_s(current) != git_oid_tostr_s(next)) {
            var revision = null;
            if (check(git_graph_descendant_of(repository, next, current), 'pull ancestry') == 1) revision = git_oid_tostr_s(next);
            else if (check(git_graph_descendant_of(repository, current, next), 'pull ancestry') != 1) {
              if (strategy == 'ff-only') throw 'Pull requires a merge or rebase; branches have diverged';
              revision = integratePull(repository, head, upstream, strategy);
            }
            if (revision != null) {
              var object = Out(Tree);
              check(git_revparse_single(object, repository, revision), 'pull commit'); target = object.value;
              check(git_checkout_tree(repository, target, null), 'pull checkout');
              var updated = Out(Reference);
              check(git_reference_set_target(updated, head, git_object_id(target), 'RayDE: pull ' + strategy), 'update branch');
              updated.value.close();
            }
          }
        }
      }
      var result = {operation:operation, remote:remoteName, branch:local, destination:destination};
      close(); return result;
    } catch (error) { close(); throw error; }
  });
}

/** Bounded pages on HEAD, following first-parent file renames as the walk moves backwards. */
function openFileHistory(path, file) {
  var cursor = openHistory(path, 'HEAD', true);
  var relative = file.startsWith(cursor.workdir) ? file.substr(cursor.workdir.length) : null;
  if (relative == null || relative == '' || relative.startsWith('../')) { cursor.close(); throw 'File is outside this repository'; }
  var current = relative, closed = false;
  function close() { if (!closed) { closed = true; cursor.close(); } }
  function next(limit = 50) {
    if (closed) throw 'File history cursor is closed';
    try {
      var page = cursor.next(limit), rows = [];
      for (commit in page.commits) {
        for (entry in cursor.changes(commit.id)) if (entry.path == current || entry.oldPath == current) {
          rows.push(commit);
          if (entry.status == 4 && entry.path == current) current = entry.oldPath;
          break;
        }
      }
      return {commits:rows, done:page.done};
    } catch (error) { close(); throw error; }
  }
  return {next:next, close:close};
}
