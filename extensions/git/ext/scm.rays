import haxe.Json;
import rayde.workspace.root;
import rayde.workspace.openFile;
import rayde.settings.get;
import rayde.window.setStatusItem;
import gitNative.repositoryStatus;
import gitNative.branchSummary;
import gitNative.openHistory;
import gitNative.remoteOperation;
import historyGraph.compactScene;
import commitFiles.selection;
import diffView.showDiff;
import commitFiles.Files;
import report.report;

function groups(entries) {
  var conflicts = [], staged = [], changes = [], untracked = [];
  function item(entry, flags) {
    var split = entry.path.lastIndexOf('/');
    return {path: entry.path, name:split < 0 ? entry.path : entry.path.substr(split + 1), directory:split < 0 ? '' : entry.path.substr(0, split), renamedFrom: entry.renamedFrom,
      badge: entry.conflicted ? '!' : (flags & (1 | 128)) != 0 ? (flags == 128 ? 'U' : 'A') : (flags & (4 | 512)) != 0 ? 'D' : (flags & (8 | 2048)) != 0 ? 'R' : 'M'};
  }
  for (entry in entries) {
    if (entry.conflicted) conflicts.push(item(entry, entry.flags));
    else {
      if (entry.index != 0) staged.push(item(entry, entry.index));
      if ((entry.workdir & 128) != 0) untracked.push(item(entry, 128));
      else if (entry.workdir != 0) changes.push(item(entry, entry.workdir));
    }
  }
  return [{id:'conflicts', title:'Merge conflicts', items:conflicts}, {id:'staged', title:'Staged', items:staged},
    {id:'changes', title:'Changes', items:changes}, {id:'untracked', title:'Untracked', items:untracked}];
}

var state = signal(null), sections = signal(groups([])), busy = signal(false);
var commits = signal([]), refs = signal([]), selected = signal(''), selectedInfo = signal('');
var expand = null;
var operation = signal(''), focus = signal('all');
var focusOptions = signal([{value:'all',label:'All branches'}, {value:'HEAD',label:'Current branch'}]);
var command = signal(null), sequence = 0;
var changed = selection(null), selectedSubject = signal('');
var refreshing = false, visible = false, refreshAgain = false;
var lastFailure = '';
var statusKey = '', entriesKey = '', historyKey = '';
var repositoryPath = null;

/** The branch, with its distance from the upstream, at the left of the status bar. */
function showBranch(summary) {
  var detail = summary.upstream ? summary.behind + '\u2193 ' + summary.ahead + '\u2191' : null;
  var tooltip = summary.upstream ? summary.branch + ': ' + summary.behind + ' behind and ' + summary.ahead + ' ahead of its upstream' : summary.branch + ': no upstream branch';
  setStatusItem('branch', {text: summary.branch, icon: 'branch', detail: detail, detailIcon: detail == null ? null : 'refresh', tooltip: tooltip, view: 'scm'});
}

function refreshBranch() {
  try {
    if (repositoryPath == null) repositoryPath = await root();
    showBranch(branchSummary(repositoryPath));
  } catch (failure) { setStatusItem('branch', null); }
}

function configureHistory(action) { expand = action; }

function choose(id) {
  if (id == selected.value && selectedInfo.value != '' && changed.error.value == '') return;
  selected.value = id;
  selectedInfo.value = '';
  selectedSubject.value = '';
  for (commit in commits.value) if (commit.id == id) {
    selectedInfo.value = commit.author + ' \u00b7 ' + commit.id.substr(0,7);
    selectedSubject.value = commit.subject;
  }
  changed.choose(id);
}

function refresh(showBusy = true) {
  if (refreshing) { if (showBusy) refreshAgain = true; return; }
  if (operation.value != '') return;
  refreshing = true;
  if (showBusy) busy.value = true;
  try {
    if (repositoryPath == null) repositoryPath = await root();
    var path = repositoryPath, snapshot = repositoryStatus(path);
    var status = Json.stringify(snapshot), entries = Json.stringify(snapshot.entries);
    if (status != statusKey) { statusKey = status; state.value = snapshot; showBranch(snapshot); }
    if (entries != entriesKey) { entriesKey = entries; sections.value = groups(snapshot.entries); }
    var nextHistory = Json.stringify({path:path, head:snapshot.head, refs:snapshot.refs, focus:focus.value});
    if (nextHistory != historyKey) {
      var cursor = openHistory(path, focus.value);
      try {
        var page = cursor.next(60);
        refs.value = cursor.refs;
        var items = [{value:'all',label:'All branches'}, {value:'HEAD',label:'Current branch'}];
        for (ref in cursor.refs) items.push({value:ref.name,label:ref.label});
        if (focus.value != 'all' && focus.value != 'HEAD' && focus.value.substr(0,5) != 'refs/') items.push({value:focus.value,label:'Commit ' + focus.value.substr(0,7)});
        focusOptions.value = items;
        commits.value = page.commits;
        var id = page.commits.length == 0 ? '' : page.commits[0].id;
        for (commit in page.commits) if (commit.id == selected.value) id = selected.value;
        choose(id);
        historyKey = nextHistory;
        cursor.close();
      } catch (failure) { cursor.close(); throw failure; }
    }
    lastFailure = '';
  } catch (failure) {
    var message = '' + failure;
    if (showBusy || message != lastFailure) report(failure);
    lastFailure = message;
  }
  refreshing = false;
  if (showBusy) busy.value = false;
  if (refreshAgain) { refreshAgain = false; spawn(() -> refresh()); }
}

function runRemote(action, strategy = null) {
  if (operation.value != '' || busy.value) return;
  operation.value = action;
  var failed = '', notice = '';
  try {
    if (action == 'pull' && strategy == null) strategy = await get('git.pullStrategy', 'ff-only');
    var path = await root(), result = remoteOperation(path, action, strategy == null ? 'ff-only' : strategy);
    notice = (action == 'fetch' ? 'Fetched from ' : action == 'pull' ? 'Pulled from ' : 'Pushed to ') + result.remote;
  } catch (failure) { failed = '' + failure; }
  operation.value = '';
  refresh();
  report(failed != '' ? failed : notice, failed != '' ? 'error' : 'success');
}

function focusHistory(ref) {
  if (busy.value) return;
  focus.value = ref;
  refresh();
  command.value = {action:'reset',sequence:++sequence};
}

function open(path) {
  var snapshot = state.value;
  if (snapshot != null && snapshot.workdir != null) await openFile(snapshot.workdir + path);
}

/** A changed file opens as its diff: staged against HEAD, changes against the index, untracked against nothing. Conflicts open the file. */
function openEntry(group, entry) {
  var snapshot = state.value;
  if (snapshot == null || snapshot.workdir == null) return;
  var full = snapshot.workdir + entry.path, old = entry.renamedFrom == null || entry.renamedFrom == '' ? entry.path : entry.renamedFrom;
  if (group == 'conflicts') { open(entry.path); return; }
  if (group == 'staged') showDiff('Staged', full, entry.badge == 'A' ? null : 'HEAD:' + old, entry.badge == 'D' ? null : ':' + entry.path, entry.badge != 'D');
  else if (group == 'untracked') showDiff('Untracked', full, null, 'workdir');
  else showDiff('Changes', full, ':' + old, entry.badge == 'D' ? null : 'workdir', entry.badge != 'D');
}

function Sidebar(props) {
  return <div id="git-scm" class="flex flex-col flex-1 min-h-0 min-w-0">
    <div class="flex items-center gap-1 px-3 py-2 border-b shrink-0">
      <span id="git-scm-branch" class="text-sm font-semibold truncate flex-1">{state.value == null ? 'Repository' : state.value.branch}</span>
      <ui-button id="git-fetch" class="w-8" size="icon" variant="ghost" tooltip="Fetch" disabled={busy.value || operation.value != ''} onClick={() -> runRemote('fetch')}><ui-icon name="fetch"/></ui-button>
      <ui-button id="git-pull" class="w-8" size="icon" variant="ghost" tooltip="Pull" disabled={busy.value || operation.value != ''} onClick={() -> runRemote('pull')}><ui-icon name="pull"/></ui-button>
      <ui-menu id="git-pull-options" class="w-8" tooltip="Pull options" disabled={busy.value || operation.value != ''}
        options={[
          {value:'ff-only',label:'Pull: fast-forward only'},
          {value:'merge',label:'Pull: merge'},
          {value:'rebase',label:'Pull: rebase'}
        ]} onSelect={e -> runRemote('pull',e.value)}/>
      <ui-button id="git-push" class="w-8" size="icon" variant="ghost" tooltip="Push" disabled={busy.value || operation.value != ''} onClick={() -> runRemote('push')}><ui-icon name="push"/></ui-button>
    </div>
    <div class="px-4 py-1 text-xs text-text-secondary shrink-0">{operation.value != '' ? operation.value == 'fetch' ? 'Fetching…' : operation.value == 'pull' ? 'Pulling…' : 'Pushing…' : busy.value ? 'Loading…' : state.value == null ? '' : state.value.entries.length + ' files'}</div>
    <ui-panel-group id="git-scm-panels" class="flex-1 min-h-0" panels={[
      {id:'changes', title:'Changes', open:true, minSize:32},
      {id:'graph', title:'Graph', open:true, size:260, minSize:32},
      {id:'commit', title:'Commit files', open:true, size:120, minSize:32}
    ]}>
    <div slot="changes" id="git-scm-working-files" class="flex flex-col gap-2 py-1 overflow-auto flex-1 min-h-0">
      <for {group in sections}>
        <div id={'git-scm-' + group.id} class="flex flex-col gap-1 min-w-0">
          <div class="flex items-center justify-between px-4 py-1">
            <span class="text-xs font-semibold text-text-secondary">{group.title}</span>
            <span class="text-xs text-text-secondary">{group.items.length}</span>
          </div>
          <for {entry in group.items}>
            <div class="flex items-center min-w-0 w-full">
              <ui-button variant="ghost" class="flex-1 min-w-0" height={24} style={{'--ui-button-padding':'0 8px'}} onClick={() -> openEntry(group.id, entry)}>
                <div class="flex items-center gap-2 w-full min-w-0 px-1">
                  <span class="text-sm truncate min-w-0">{entry.name}</span>
                  <span class="text-xs text-text-tertiary truncate flex-1 min-w-0">{entry.directory}</span>
                  <span class={entry.badge == '!' ? 'text-xs text-error' : entry.badge == 'U' || entry.badge == 'A' ? 'text-xs text-success' : 'text-xs text-warning'}>{entry.badge}</span>
                </div>
              </ui-button>
              <ui-button size="icon" variant="ghost" class="git-open-file w-6 shrink-0" height={24} tooltip="Open file" onClick={() -> open(entry.path)}><ui-icon name="code"/></ui-button>
            </div>
          </for>
          <if {group.items.length == 0}><span class="px-4 text-xs text-text-tertiary">No files</span></if>
        </div>
      </for>
    </div>
    <div slot="graph" id="git-scm-graph" class="flex flex-col flex-1 min-h-0 min-w-0">
      <div class="flex items-center gap-2 px-3 py-2 shrink-0">
        <ui-select id="git-scm-focus" class="flex-1 min-w-0" options={focusOptions} value={focus} disabled={busy} onChange={e -> focusHistory(e.value)}/>
        <ui-button id="git-scm-focus-commit" class="w-8" size="icon" variant="ghost" tooltip="Focus on selected commit" disabled={busy.value || selected.value == ''} onClick={() -> focusHistory(selected.value)}><ui-icon name="focus"/></ui-button>
        <ui-button id="git-scm-expand" class="w-8" size="icon" variant="ghost" tooltip="Maximize graph" onClick={() -> { if (expand != null) expand(focus.value); }}><ui-icon name="maximize"/></ui-button>
      </div>
      <canvas-kit id="git-scm-canvas" class="flex-1 min-h-0" navigation="scroll" textRendering="native" scene={compactScene(commits.value, refs.value, selected.value)}
        selected={selected.value == '' ? [] : [selected.value]} command={command} onClick={e -> choose(e.region)}/>
      <span id="git-scm-selection" class="text-xs text-text-tertiary truncate px-3 py-1 shrink-0">{busy.value ? 'Loading history\u2026' : selectedInfo.value}</span>
    </div>
    <div slot="commit" class="flex flex-col flex-1 min-h-0 overflow-auto py-1">
      <span id="git-scm-commit-subject" class="px-3 py-1 text-xs font-semibold truncate">{selectedSubject}</span>
      <Files state={changed} id="git-scm-commit-files"/>
    </div>
    </ui-panel-group>
  </div>;
}

mount(() -> <Sidebar/>, 'scm');
registerCommand('git.refresh', args -> refresh());
registerCommand('git.fetch', args -> runRemote('fetch'));
registerCommand('git.pull', args -> runRemote('pull'));
registerCommand('git.push', args -> runRemote('push'));
onTool('git-refresh', () -> refresh());
onHook('file.saved', e -> refresh());
onHook('view.visibility', e -> { if (e.id == 'scm') { visible = e.visible; if (visible) refresh(false); } });
spawn(() -> { var quiet = 0; while (true) { await sleep(2500); if (visible) { quiet = 0; refresh(false); } else if (++quiet >= 4) { quiet = 0; refreshBranch(); } } });
spawn(() -> refresh());
