import timeline.Timeline;
import rayde.workspace.root;
import gitNative.openHistory;
import historyGraph.scene;
import historyGraph.timestamp;
import scm.refresh;
import scm.configureHistory;
import commitFiles.selection;
import commitFiles.Files;
import report.report;
import commitHover.commitHover;

var opened = null;

function History(props) {
  var commits = signal([]), refs = signal([]), options = signal([{value: 'all', label: 'All references'}]);
  var branch = signal('all'), selected = signal(''), detail = signal(null), busy = signal(false), done = signal(false);
  var command = signal(null);
  var changed = selection(props.path);
  var remote = signal(''), hover = commitHover(props.path);
  var cursor = null, live = true, sequence = 0;
  function choose(id) {
    selected.value = id;
    detail.value = null;
    for (commit in commits.value) if (commit.id == id) detail.value = commit;
    changed.choose(id);
  }
  function page() {
    if (busy.value || cursor == null || done.value) return;
    busy.value = true;
    try {
      var page = cursor.next(100);
      if (live) { commits.value = commits.value.concat(page.commits); done.value = page.done; }
    } catch (failure) {
      if (cursor != null) { cursor.close(); cursor = null; }
      if (live) report(failure);
    }
    busy.value = false;
  }
  function load(ref) {
    if (busy.value) return;
    busy.value = true;
    if (cursor != null) { cursor.close(); cursor = null; }
    try {
      var next = openHistory(props.path, ref);
      if (!live) { next.close(); return; }
      cursor = next;
      remote.value = next.remote;
      refs.value = next.refs;
      var items = [{value: 'all', label: 'All references'}, {value:'HEAD',label:'Current branch'}];
      for (item in next.refs) items.push({value: item.name, label: item.label});
      if (ref != 'all' && ref != 'HEAD' && ref.substr(0,5) != 'refs/') items.push({value:ref,label:'Commit ' + ref.substr(0,7)});
      options.value = items;
      branch.value = ref;
      var page = next.next(100);
      if (live) {
        commits.value = page.commits;
        done.value = page.done;
        choose(page.commits.length > 0 ? page.commits[0].id : '');
        command.value = {action:'reset', sequence:++sequence};
      }
    } catch (failure) {
      if (cursor != null) { cursor.close(); cursor = null; }
      if (live) { commits.value = []; choose(''); report(failure); }
    }
    busy.value = false;
  }
  onCleanup(() -> {
    live = false;
    if (cursor != null) { cursor.close(); cursor = null; }
    opened = null;
  });
  spawn(() -> load(props.focus));
  return <div class="flex flex-col flex-1 min-h-0 min-w-0">
    <div class="flex items-center gap-2 px-4 py-3 border-b shrink-0">
      <h2 class="text-base font-semibold m-0">Git history</h2>
      <ui-select id="git-history-branch" class="w-48" options={options} value={branch} disabled={busy}
        onChange={e -> load(e.value)}/>
      <div class="flex-1"/>
      <ui-button id="git-history-focus" variant="ghost" size="icon" class="w-8" tooltip="Focus on selected commit" disabled={busy.value || selected.value == ''} onClick={() -> load(selected.value)}><ui-icon name="focus"/></ui-button>
      <ui-button id="git-history-all" variant="ghost" size="icon" class="w-8" tooltip="Show all references" disabled={busy.value || branch.value == 'all'} onClick={() -> load('all')}><ui-icon name="filter-off"/></ui-button>
      <ui-button id="git-history-refresh" variant="ghost" size="icon" class="w-8" tooltip="Refresh history" disabled={busy} onClick={() -> load(branch.value)}><ui-icon name="refresh"/></ui-button>
    </div>
    <div class="flex flex-1 min-h-0">
      <div class="flex flex-col flex-1 min-w-0">
        <canvas-kit id="git-history-canvas" class="flex-1 min-h-0" navigation="scroll" textRendering="native" scene={scene(commits.value, refs.value, selected.value, remote.value)} hoverCard={hover.card}
          selected={selected.value == '' ? [] : [selected.value]} command={command}
          onClick={e -> choose(e.region)} onHover={hover.hover}/>
        <div class="flex items-center gap-3 px-4 py-2 border-t shrink-0">
          <span id="git-history-count" class="text-xs text-text-secondary">{commits.value.length} commits</span>
          <ui-button id="git-history-more" variant="outline" class="w-24" disabled={busy.value || done.value || cursor == null} onClick={() -> page()}>Load more</ui-button>
        </div>
      </div>
      <div id="git-history-details" class="flex flex-col gap-3 w-64 p-4 border-l shrink-0 overflow-auto">
        <span class="text-xs text-text-secondary uppercase">Commit</span>
        <if {detail.value != null}>
          <h3 class="text-base font-semibold m-0">{detail.value.subject}</h3>
          <ui-button id="git-history-copy" variant="ghost" class="self-start" tooltip="Copy commit hash" copyText={selected.value}><span class="text-xs text-text-secondary">{selected.value.substr(0, 12)}</span><ui-icon name="copy"/></ui-button>
          <div class="flex items-center gap-2"><ui-avatar profile={{id:detail.value.id, remote:remote.value, author:detail.value.author, email:detail.value.email}}/><span class="text-sm">{detail.value.author}</span></div>
          <span class="text-xs text-text-secondary">{detail.value.email}</span>
          <span class="text-xs text-text-secondary">{timestamp(detail.value.time)}</span>
          <span class="text-xs text-text-secondary uppercase">Parents</span>
          <for {parent in detail.value.parents}><ui-button variant="ghost" class="self-start" tooltip="Copy parent commit hash" copyText={parent}><span class="text-xs">{parent.substr(0, 12)}</span><ui-icon name="copy"/></ui-button></for>
          <span class="text-xs text-text-secondary uppercase">Changed files</span>
          <if {detail.value.parents.length > 1}><span class="text-xs text-text-secondary">Compared with first parent</span></if>
          <Files state={changed} id="git-history-files" flush={true}/>
          <else><p class="text-sm text-text-secondary">{busy.value ? 'Loading history…' : 'No commits'}</p></if>
      </div>
    </div>
  </div>;
}

function showHistory(focus = 'all') {
  if (opened != null) return;
  var path = await root();
  if (opened == null) opened = mount(() -> <History path={path} focus={focus}/>, 'tab:Git history');
}

registerCommand('git.history', args -> showHistory());
onTool('git-history', () -> showHistory());
configureHistory(showHistory);
