{
  "name": "Dashboard",
  "version": "0.1.0",
  "description": "One extension, a view in each of three parts of the layout",
  "main": "ext/main.rays",
  "sources": ["ext"],
  "views": [
    {
      "id": "main",
      "title": "Overview",
      "icon": "home",
      "location": "sidebar",
      "tools": [{"id": "refresh", "title": "Refresh", "icon": "refresh"}]
    },
    {"id": "inspector", "title": "Inspector", "icon": "eye", "location": "secondary"},
    {"id": "log", "title": "Log", "icon": "list", "location": "panel"}
  ]
}
